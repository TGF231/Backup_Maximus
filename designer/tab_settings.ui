      </widget>
     </item>
     <item row="1" column="1" colspan="3">
      <widget class="QLineEdit" name="editEmail">
       <property name="placeholderText"><string>ti@suaempresa.com.br</string></property>
      </widget>
     </item>

     <item row="2" column="0">
      <widget class="QLabel" name="lblTimeout">
       <property name="role" stdset="0"><string notr="true">field</string></property>
       <property name="minimumSize"><size><width>124</width><height>0</height></size></property>
       <property name="maximumSize"><size><width>124</width><height>16777215</height></size></property>
       <property name="alignment"><set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set></property>
       <property name="text"><string>Alertar se sem backup há</string></property>
      </widget>
     </item>
     <item row="2" column="1">
      <widget class="QSpinBox" name="spinTimeout">
       <property name="minimumSize"><size><width>120</width><height>0</height></size></property>
       <property name="maximumSize"><size><width>120</width><height>16777215</height></size></property>
       <property name="buttonSymbols"><enum>QAbstractSpinBox::NoButtons</enum></property>
       <property name="minimum"><number>1</number></property>
       <property name="maximum"><number>8760</number></property>
       <property name="suffix"><string> horas</string></property>
      </widget>
     </item>

     <item row="3" column="1" colspan="3">
      <widget class="QLabel" name="lblAlertHint">
       <property name="role" stdset="0"><string notr="true">hintWarn</string></property>
       <property name="wordWrap"><bool>true</bool></property>
       <property name="text"><string/></property>
      </widget>
     </item>
     <item row="5" column="0">
      <widget class="QLabel" name="lblReminder">
       <property name="role" stdset="0"><string notr="true">field</string></property>
       <property name="minimumSize"><size><width>124</width><height>0</height></size></property>
       <property name="maximumSize"><size><width>124</width><height>16777215</height></size></property>
       <property name="alignment"><set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set></property>
       <property name="text"><string>Lembrar backup às</string></property>
      </widget>
     </item>
     <item row="5" column="1" colspan="3">
      <layout class="QHBoxLayout" name="reminderLayout">
       <property name="spacing"><number>10</number></property>
       <item>
        <widget class="QTimeEdit" name="timeReminder">
         <property name="minimumSize"><size><width>96</width><height>0</height></size></property>
         <property name="maximumSize"><size><width>96</width><height>16777215</height></size></property>
         <property name="displayFormat"><string>HH:mm</string></property>
         <property name="buttonSymbols"><enum>QAbstractSpinBox::ButtonSymbols::NoButtons</enum></property>
        </widget>
       </item>
       <item>
        <widget class="QCheckBox" name="chkReminder">
         <property name="text"><string>Mostrar lembrete diário</string></property>
        </widget>
       </item>
       <item>
        <spacer name="reminderSpacer">
         <property name="orientation"><enum>Qt::Orientation::Horizontal</enum></property>
         <property name="sizeHint" stdset="0"><size><width>1</width><height>0</height></size></property>
        </spacer>
       </item>
      </layout>
     </item>
     <item row="6" column="1" colspan="3">
      <widget class="QLabel" name="lblReminderHint">
       <property name="role" stdset="0"><string notr="true">hint</string></property>
       <property name="wordWrap"><bool>true</bool></property>
       <property name="text"><string/></property>
      </widget>
     </item>
     <item row="4" column="1" colspan="3">
      <widget class="QCheckBox" name="chkSendReport">
       <property name="text"><string>Enviar relatório por e-mail a cada backup</string></property>
      </widget>
     </item>
    </layout>
   </item>

   <item>
    <widget class="QFrame" name="dividerIdent">
