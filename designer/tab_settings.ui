     <item row="1" column="0">
      <widget class="QLabel" name="lblSmtpUser">
       <property name="role" stdset="0"><string notr="true">field</string></property>
       <property name="minimumSize"><size><width>124</width><height>0</height></size></property>
       <property name="maximumSize"><size><width>124</width><height>16777215</height></size></property>
