<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>TabSettings</class>
 <!--
   Aba Configuracoes. Mesma grade de 5 colunas da aba Backups, para os campos
   das duas telas alinharem na mesma posicao:

     col 0  rotulo, largura fixa 124
     col 1  campo principal (unica coluna que estica)
     col 2  segundo campo
     col 3  terceiro campo / caixa de selecao
     col 4  botao "..."
 -->
 <widget class="QWidget" name="TabSettings">
  <property name="geometry">
   <rect><x>0</x><y>0</y><width>1000</width><height>640</height></rect>
  </property>
  <layout class="QVBoxLayout" name="rootLayout">
   <property name="leftMargin"><number>16</number></property>
   <property name="topMargin"><number>14</number></property>
   <property name="rightMargin"><number>16</number></property>
   <property name="bottomMargin"><number>12</number></property>
   <property name="spacing"><number>8</number></property>

   <item>
    <widget class="QLabel" name="lblIdentSection">
     <property name="role" stdset="0"><string notr="true">section</string></property>
     <property name="text"><string>IDENTIFICAÇÃO E ALERTAS</string></property>
    </widget>
   </item>
   <item>
    <layout class="QGridLayout" name="gridIdent">
     <property name="horizontalSpacing"><number>8</number></property>
     <property name="verticalSpacing"><number>7</number></property>
     <property name="leftMargin"><number>0</number></property>
     <property name="rightMargin"><number>0</number></property>

     <item row="0" column="0">
      <widget class="QLabel" name="lblCompany">
       <property name="role" stdset="0"><string notr="true">field</string></property>
       <property name="minimumSize"><size><width>124</width><height>0</height></size></property>
       <property name="maximumSize"><size><width>124</width><height>16777215</height></size></property>
       <property name="alignment"><set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set></property>
       <property name="text"><string>Nome da empresa</string></property>
      </widget>
     </item>
     <item row="0" column="1" colspan="3">
      <widget class="QLineEdit" name="editCompany"/>
     </item>

     <item row="1" column="0">
      <widget class="QLabel" name="lblEmail">
       <property name="role" stdset="0"><string notr="true">field</string></property>
       <property name="minimumSize"><size><width>124</width><height>0</height></size></property>
       <property name="maximumSize"><size><width>124</width><height>16777215</height></size></property>
       <property name="alignment"><set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set></property>
